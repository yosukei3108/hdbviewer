{
  "name": "hdbviewer",
  "displayName": "HDB Viewer",
  "description": "Display the contents of a Tokyo Cabinet Hash DB file as a table",
  "publisher": "yosukei3108",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yosukei3108/hdbviewer"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "hdbviewer.hashDB",
        "displayName": "Tokyo Cabinet Hash DB",
        "selector": [
          {
            "filenamePattern": "*.tch"
          },
          {
            "filenamePattern": "*.hdb"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "hdbviewer.open",
        "title": "HDB Viewer: Open Hash DB"
      }
    ],
    "configuration": {
      "title": "HDB Viewer",
      "properties": {
        "hdbviewer.tchmgrPath": {
          "type": "string",
          "default": "tchmgr",
          "description": "Path to the tchmgr command. Specify the full path if it is not on PATH."
        },
        "hdbviewer.recordsPerPage": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Number of records to display per page"
        },
        "hdbviewer.noLock": {
          "type": "boolean",
          "default": false,
          "description": "When true, read the file without taking a file lock (tchmgr -nl). When false, do not wait for the lock (-nb)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src media",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
